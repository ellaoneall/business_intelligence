## Demo
```{r demo}
con = DBI::dbConnect(RSQLite::SQLite(), "../data/scout.db")
postings = DBI::dbReadTable(con, "scout_postings") |> tibble::as_tibble()
DBI::dbDisconnect(con)

jobs = postings |>
  dplyr::select(company, title, location_state, remote, category, posted_at, last_seen_at) |>
  dplyr::mutate(dplyr::across(dplyr::ends_with("_at"), as.Date),
                days_open = as.numeric(last_seen_at - posted_at))

# For Q1, to answer it, we need to following:
# - number of jobs per category
# - fraction of those jobs that are remote friendly 

jobs |> 
  dplyr::group_by(category) |> 
  dplyr::summarise(
    postings = dplyr::n(),# counting the number of rows per category
    remote_share = mean(remote) |> round(3)
    )

# Q2: Among the full time jobs, which states have the highest remote share?
jobs |> 
  dplyr::filter(category == 'fulltime') |> 
  dplyr::group_by(location_state, category) |> 
  dplyr::summarise(
    postings = dplyr::n(),# counting the number of rows per category
    remote_share = mean(remote) |> round(3)
    ) |> 
  dplyr::filter(postings >= 50) |> # up to you to determine the min threshold
  dplyr::arrange(dplyr::desc(remote_share)) |> 
  head(3)
```

```{r Class_Practice}
con = DBI::dbConnect(RSQLite::SQLite(), "../data/midwest_airbnb.db")
listings = DBI::dbReadTable(con, "listings") |>
  tibble::as_tibble()
DBI::dbDisconnect(con)
dplyr::glimpse(listings)

# Q1: Approach A - simply count the repetitions within the city col
table(listings$city)

# alternatively, group_by > summarize (n()) -- that returns a df 
# in (a) we returned a named vector

listings |>
  dplyr::group_by(city)|>
  dplyr::summarize(
    city_count = dplyr::n()
  ) -> practice_q1
practice_q1

# Q2: For entire homes (room_type == "Entire home/apt") that sleep four or more, what is the median price in each city?

listings |>
  dplyr::filter(
    room_type == "Entire home/apt", accommodates >= 4)|>
      dplyr:: group_by(city) |>
      dplyr:: summarize(
        median_price = median(price)
      )
  
# Q3: Add price_per_person = price / accommodates. Which three listings are cheapest per person? Believe them?
# Note that this is per listing, and we need to create a new col

listings|>
  dplyr::mutate(
    price_per_person = price / accommodates # LHS = new col name; RHS is the math to create the new col[ this is done by row]
  ) |>
  dplyr::arrange(price_per_person)|>
  # you don't need to fo this step(next step); I am just doing it so we can look at the output in a more compact way (less cols)
  dplyr::select(city, name, price, accommodates, price_per_person)|>
  head(3) # cheapest listings; tail would provide the most expensive listings since we are sorting in an ascending order by price_per_person

# Q4:Which five host_names have the most listings?

listings|>
  dplyr::count(host_name, host_id, sort=TRUE) # short cut for group_by and then n()
  
  
```

